{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dreads/bell-state-explorer/main/schema/locale-bundle.schema.json",
  "title": "Bell state explorer locale bundle",
  "description": "Shape of a locale bundle contributed via PR (locales/<code>.json). A bundle may translate any subset of the keys under 'strings' — missing keys fall back to English at runtime, so a bundle never needs to be complete to be valid or useful.",
  "type": "object",
  "required": ["meta", "strings"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "strings": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["code", "endonym", "englishName", "direction", "targetsVersion"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$",
          "description": "BCP 47 language tag, e.g. \"ar\", \"pt-BR\"."
        },
        "endonym": {
          "type": "string",
          "description": "The language's own name for itself, e.g. \"العربية\" — shown in the language picker."
        },
        "englishName": {
          "type": "string",
          "description": "English name of the language, for contributors and as a fallback label."
        },
        "direction": {
          "enum": ["ltr", "rtl"],
          "description": "Self-declared text direction. Not inferred from the runtime's Intl support, so any script works without platform assumptions."
        },
        "targetsVersion": {
          "type": "string",
          "description": "Which locales/en.json meta.targetsVersion this bundle was written against. Informational — used to flag a bundle as possibly stale, never to reject it."
        }
      }
    },
    "strings": {
      "type": "object",
      "description": "Dot-path-addressed nested string tree. Any key may be omitted; omitted keys fall back to English per-key at runtime (src/i18n.js translate()).",
      "additionalProperties": false,
      "properties": {
        "interpret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fully-dephased": { "type": "string" },
            "product-state": { "type": "string" },
            "maximally-entangled": { "type": "string" },
            "pure-partial": { "type": "string" },
            "partially-dephased": { "type": "string" }
          }
        },
        "ui": {
          "type": "object",
          "description": "Static chrome plus small templates (index.html labels/buttons, app.js's qubit/degree/percent formatting). {placeholder} values like {qubit}, {sign}, {family} are literal notation (q0, +/-, Ψ/Φ) and are not themselves translated.",
          "additionalProperties": false,
          "properties": {
            "docTitle": { "type": "string" },
            "metaDescription": { "type": "string" },
            "languageLabel": { "type": "string" },
            "heading": { "type": "string" },
            "circuitHeading": { "type": "string" },
            "subtitle": { "type": "string" },
            "inputStateLegend": { "type": "string" },
            "couplingNote": { "type": "string" },
            "channelLegend": { "type": "string" },
            "dephasingLabel": { "type": "string" },
            "balanceLabel": { "type": "string" },
            "rotateQ0Label": { "type": "string" },
            "rotateQ1Label": { "type": "string" },
            "resetButton": { "type": "string" },
            "exportButton": { "type": "string" },
            "exportCircuitLegend": { "type": "string" },
            "exportTargetLabel": { "type": "string" },
            "exportCircuitButton": { "type": "string" },
            "exportCircuitNote": { "type": "string" },
            "exportCircuitError": { "type": "string" },
            "keyLargeMagnitude": { "type": "string" },
            "keySmallMagnitude": { "type": "string" },
            "keyZero": { "type": "string" },
            "keyNegative": { "type": "string" },
            "matrixKeyParagraph": { "type": "string" },
            "concurrenceLabel": { "type": "string" },
            "purityLabel": { "type": "string" },
            "bellStateLabel": { "type": "string" },
            "qubitEquals": { "type": "string", "description": "Template: {qubit}, {value}" },
            "phaseSign": { "type": "string", "description": "Template: {sign}" },
            "familyLabel": { "type": "string", "description": "Template: {family}" },
            "degrees": { "type": "string", "description": "Template: {value}" },
            "percent": { "type": "string", "description": "Template: {value}" }
          }
        },
        "matrixGrid": {
          "type": "object",
          "description": "Density matrix SVG title/description and the sr-only table caption; entryTemplate/summaryTemplate/joinText/allZero together build the aria-hidden <desc> summary.",
          "additionalProperties": false,
          "properties": {
            "svgTitle": { "type": "string" },
            "svgDescIntro": { "type": "string" },
            "tableCaption": { "type": "string" },
            "entryTemplate": { "type": "string", "description": "Template: {row}, {col}, {value}" },
            "summaryTemplate": { "type": "string", "description": "Template: {entries}" },
            "joinText": { "type": "string" },
            "allZero": { "type": "string" }
          }
        },
        "blochSphere": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "string", "description": "Template: {qubit}" },
            "vector": { "type": "string", "description": "Template: {qubit}, {x}, {y}, {z}, {magnitude}" }
          }
        },
        "circuitDiagram": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "description": "Template: {q0}, {q1}, {label}, {alpha0}, {alpha1}" }
          }
        }
      }
    }
  }
}
